# Bot-Token aus dem Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=
# Application ID (General Information -> Application ID)
CLIENT_ID=
# Server-ID (Rechtsklick auf den Server -> "Server-ID kopieren", Entwicklermodus muss an sein).
# Leer lassen = Befehle global registrieren (kann bis zu 1 Stunde dauern).
GUILD_ID=

# Alles Weitere stellst du direkt in Discord ein: /event config (Staff-Rollen, Zeitzone, Ergebniskanal).
# Die folgenden Werte sind nur Startwerte bzw. Fallbacks.

# Rollen-Namen, die Events verwalten dürfen, solange in /event config keine Staff-Rollen gewählt sind
STAFF_ROLE_NAMES=Owner,Developer,Admin
# Optional: zusätzlich Rollen-IDs (Komma-getrennt), die immer Staff sind
STAFF_ROLE_IDS=
# Optional: Standard-Ergebniskanal (Kanal-ID)
RESULTS_CHANNEL_ID=
# Zeitzone für Datumsangaben wie "2026-10-31 18:00"
TIMEZONE=Europe/Berlin

# OPTIONAL: YouTube Data API v3 Key – damit findet der Bot bei Video-Contests YouTube-Videos automatisch.
# Ohne Key tragen YouTuber ihre Video-Links selbst ein, die Aufrufe werden von der Videoseite gelesen.
YOUTUBE_API_KEY=
# Vorschlag für den Hashtag bei neuen Video-Contests (ohne #), lässt sich pro Event ändern
HASHTAG=weakspot
