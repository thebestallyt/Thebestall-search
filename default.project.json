{
  "name": "NovaClash",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$properties": {
        "CameraMaxZoomDistance": 45,
        "CameraMinZoomDistance": 6,
        "CharacterWalkSpeed": 18,
        "CharacterUseJumpPower": true,
        "CharacterJumpPower": 52,
        "EnableMouseLockOption": true
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Players": {
      "$properties": {
        "RespawnTime": 3
      }
    },

    "Workspace": {
      "$properties": {
        "StreamingEnabled": false,
        "FallenPartsDestroyHeight": -120,
        "Gravity": 196.2
      }
    },

    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "ClockTime": 14.6,
        "GeographicLatitude": 38,
        "Brightness": 2.6,
        "ExposureCompensation": 0.1,
        "EnvironmentDiffuseScale": 0.55,
        "EnvironmentSpecularScale": 0.5,
        "GlobalShadows": true,
        "ShadowSoftness": 0.3,
        "Ambient": [0.3137, 0.3294, 0.3843],
        "OutdoorAmbient": [0.5255, 0.5333, 0.5804]
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
