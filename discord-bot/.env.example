# Bot-Token aus dem Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=
# Application ID (General Information -> Application ID)
CLIENT_ID=
# Server-ID (Rechtsklick auf den Server -> "Server-ID kopieren", Entwicklermodus muss an sein).
# Leer lassen = Befehle global registrieren (kann bis zu 1 Stunde dauern).
GUILD_ID=

# Rollen, die Contests verwalten dürfen (Namen, Komma-getrennt, Groß/Klein egal).
# Server-Besitzer und alle mit "Administrator"-Recht dürfen immer.
STAFF_ROLE_NAMES=Owner,Developer,Admin
# Optional: zusätzlich Rollen-IDs (Komma-getrennt)
STAFF_ROLE_IDS=

# Optional: Kanal-ID, in den die Ergebnisliste + Gewinner-Auswahl am Ende geschickt wird
# (z. B. ein Staff-Kanal). Leer = derselbe Kanal wie der Contest.
RESULTS_CHANNEL_ID=

# OPTIONAL: YouTube Data API v3 Key (siehe README). Mit Key findet der Bot YouTube-Videos automatisch.
# Ohne Key (leer lassen) tragen YouTuber ihre Video-Links selbst ein, die Aufrufe werden von der Videoseite gelesen.
YOUTUBE_API_KEY=
# Hashtag, den die Videos im Titel/in der Beschreibung haben müssen (ohne #)
HASHTAG=weakspot
# true = nur Videos zählen, die nach dem Contest-Start hochgeladen wurden
ONLY_NEW_VIDEOS=true
