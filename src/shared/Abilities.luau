local Abilities = {}
Abilities.List = defs
Abilities.ById = {} :: { [string]: AbilityDef }
for _, def in defs do
	Abilities.ById[def.Id] = def
end

function Abilities.Get(id: string?): AbilityDef?
	if id == nil then
		return nil
	end
	return Abilities.ById[id]
end

-- Alle Faehigkeiten einer Seltenheit (Exklusive tauchen nie in Kisten auf)
function Abilities.ByRarity(rarityId: string): { AbilityDef }
	local out = {}
	for _, def in defs do
		if def.Rarity == rarityId and not def.Exclusive then
			table.insert(out, def)
		end
	end
	return out
end

return Abilities
